# Variables usadas por docker-compose.yml para el contenedor de PostgreSQL
# (y propagadas al backend, para que ambos usen siempre las mismas
# credenciales). Copiar a ".env" en la raiz del proyecto:
#
#   cp .env.example .env
#
# Las credenciales de aplicacion (JWT_SECRET, ADMIN_KEY, etc.) van aparte en
# backend/.env — ver backend/.env.example.

DB_NAME=pedidosavoz
DB_USER=pedidosavoz
DB_PASSWORD=changeme
