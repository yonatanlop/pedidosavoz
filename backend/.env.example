PORT=3000

DB_HOST=postgres
DB_PORT=5432
DB_NAME=pedidosavoz
DB_USER=pedidosavoz
DB_PASSWORD=changeme

JWT_SECRET=changeme_jwt_secret
JWT_EXPIRES_IN=12h

# Clave para poder registrar nuevas meseras/meseros (endpoint /api/auth/register)
ADMIN_KEY=changeme_admin_key

CORS_ORIGIN=*

# Zona horaria del restaurante (afecta fecha/hora guardadas y el corte de turno).
TZ=America/Bogota

# Hora (HH:MM, en la zona horaria de arriba) desde la que un pedido nuevo se
# cuenta como "almuerzo" en vez de "desayuno". El numero de pedido reinicia
# en 1 en cada turno y cada dia.
TURNO_ALMUERZO_DESDE=11:00
